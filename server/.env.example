# ─────────────────────────────────────────────────────────────────────
# Variables lues par le backend (server/). Copier en `server/.env` et remplir.
# `server/.env` est gitignoré — ne jamais le committer.
# ─────────────────────────────────────────────────────────────────────

# --- Connexion PostgreSQL ---
# En Docker, DB_HOST=db (nom du service Compose) et DB_PORT=5432 (port interne
# du conteneur — indépendant du remap hôte 5433 de docker-compose.yml).
DB_HOST=db
DB_PORT=5432
DB_USER=agri
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
DB_NAME=agri_app

# --- Serveur HTTP ---
PORT=4000

# --- Signature des JWT ---
# DOIT être une chaîne aléatoire longue et secrète en production.
# Générer p. ex. avec :  openssl rand -base64 48
JWT_SECRET=CHANGEZ_MOI_secret_aleatoire_long

# --- E-mail (optionnel) ---
# Sans ces valeurs, les fonctions e-mail échouent proprement : code MFA par
# e-mail, e-mail de bienvenue employé, envoi de devis au client.
# Identifiants Gmail (mot de passe d'application, pas le mot de passe du compte).
EMAIL_USER=
EMAIL_PASS=
