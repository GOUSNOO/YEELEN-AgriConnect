# Gabarit des variables d'environnement de PRODUCTION pour le backend, injectées
# dans le conteneur `backend` via `env_file: ./server/.env` (docker-compose.yml).
# Gitignored, ne jamais committer le vrai `server/.env` rempli.
#
# Usage : copier ce fichier en `server/.env` sur le Droplet, puis remplacer
# chaque valeur. Voir docs/deploiement.md pour le runbook complet.

PORT=4000

# DB_HOST est écrasé par docker-compose.yml (environment: DB_HOST: db) pour que
# le backend parle au conteneur `db` sur le réseau Compose interne — la valeur
# ci-dessous n'est utilisée que si le backend tourne hors Docker (pas le cas en
# prod). DB_PORT reste 5432 (port interne au conteneur, indépendant du mapping
# hôte 5433 utilisé en dev local).
DB_HOST=db
DB_PORT=5432

# DOIT être identique à DB_USER/DB_PASSWORD/DB_NAME du `.env` racine — sinon le
# backend ne peut pas se connecter à Postgres (erreur d'authentification au
# démarrage, le conteneur ne démarrera pas, voir server/src/server.js).
DB_USER=agri_prod
DB_PASSWORD=change-me-mot-de-passe-fort
DB_NAME=agri_app

# Secret de signature des JWT. DOIT être une valeur longue et aléatoire,
# différente de tout ce qui a pu circuler en dev — un JWT_SECRET compromis
# permet de forger des tokens valides pour n'importe quel compte. Générer par
# exemple avec : openssl rand -base64 48
JWT_SECRET=change-me-genere-avec-openssl-rand-base64-48
