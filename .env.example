# ─────────────────────────────────────────────────────────────────────
# Variables lues par docker-compose.yml (+ docker-compose.prod.yml).
# Copier en `.env` et remplir. `.env` est gitignoré — ne jamais le committer.
# ─────────────────────────────────────────────────────────────────────

# --- Base de données (service `db`) ---
DB_USER=agri
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
DB_NAME=agri_app

# --- Build du frontend (arg Docker, injecté à `docker compose build`) ---
# En production le frontend et l'API sont servis par Caddy sur le MÊME domaine,
# donc une URL relative suffit et fonctionne quel que soit le domaine :
VITE_API_URL=/api
# En dev local sans Caddy, utiliser plutôt : http://localhost:4000/api

# --- Domaine public (service `caddy`, prod uniquement) ---
# Le certificat HTTPS est émis automatiquement par Caddy pour ce domaine.
DOMAIN=agriconnect.exemple.com
